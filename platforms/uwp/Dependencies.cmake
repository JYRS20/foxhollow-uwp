include_guard(GLOBAL)
include(FetchContent)

set(FOXHOLLOW_UWP_DEP_ROOT "" CACHE PATH "")
if (NOT FOXHOLLOW_UWP_DEP_ROOT)
    FetchContent_Declare(foxhollow_uwp_dep
        GIT_REPOSITORY https://github.com/SternXD/uwp-dep.git
        GIT_TAG ae39aa004ae127bd00f8262d28b401f8e4ed8728)
    FetchContent_MakeAvailable(foxhollow_uwp_dep)
    set(FOXHOLLOW_UWP_DEP_ROOT "${foxhollow_uwp_dep_SOURCE_DIR}")
elseif (NOT TARGET LIBUWP)
    add_subdirectory("${FOXHOLLOW_UWP_DEP_ROOT}" "${CMAKE_BINARY_DIR}/uwp-dep" EXCLUDE_FROM_ALL)
endif ()

set(_uwp "${FOXHOLLOW_UWP_DEP_ROOT}/x64")
function(foxhollow_uwp_import target name)
    foreach (path IN ITEMS "${_uwp}/bin/${name}.dll" "${_uwp}/lib/${name}.lib")
        if (NOT EXISTS "${path}")
            message(FATAL_ERROR "${path}")
        endif ()
    endforeach ()
    add_library(${target} SHARED IMPORTED GLOBAL)
    set_target_properties(${target} PROPERTIES
        IMPORTED_LOCATION "${_uwp}/bin/${name}.dll"
        IMPORTED_IMPLIB "${_uwp}/lib/${name}.lib"
        INTERFACE_INCLUDE_DIRECTORIES "${_uwp}/include")
endfunction()

foxhollow_uwp_import(foxhollow_uwp_dawn webgpu_dawn)
add_library(dawn::webgpu_dawn ALIAS foxhollow_uwp_dawn)
add_library(dawn::dawncpp_headers INTERFACE IMPORTED GLOBAL)
set_target_properties(dawn::dawncpp_headers PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_uwp}/include")
foxhollow_uwp_import(foxhollow_uwp_sdl SDL3)
add_library(SDL3::SDL3 ALIAS foxhollow_uwp_sdl)
foxhollow_uwp_import(foxhollow_uwp_nod nod)
find_program(FOXHOLLOW_DUMPBIN dumpbin REQUIRED)
find_program(FOXHOLLOW_LIB lib REQUIRED)
execute_process(COMMAND "${FOXHOLLOW_DUMPBIN}" /exports "${_uwp}/bin/nod.dll"
    OUTPUT_VARIABLE _nod_exports COMMAND_ERROR_IS_FATAL ANY)
string(REPLACE "\n" ";" _nod_export_lines "${_nod_exports}")
set(_nod_def "LIBRARY nod.dll\nEXPORTS\n")
set(_nod_export_count 0)
foreach (line IN LISTS _nod_export_lines)
    if (line MATCHES "^[ \t]+[0-9]+[ \t]+[0-9A-Fa-f]+[ \t]+[0-9A-Fa-f]+[ \t]+([A-Za-z_][A-Za-z_0-9]*)[ \r]*$")
        string(APPEND _nod_def "${CMAKE_MATCH_1}\n")
        math(EXPR _nod_export_count "${_nod_export_count} + 1")
    endif ()
endforeach ()
if (_nod_export_count EQUAL 0)
    message(FATAL_ERROR "nod.dll: exports")
endif ()
file(WRITE "${CMAKE_BINARY_DIR}/nod-uwp.def" "${_nod_def}")
execute_process(COMMAND "${FOXHOLLOW_LIB}" /nologo /machine:x64
    "/def:${CMAKE_BINARY_DIR}/nod-uwp.def" "/out:${CMAKE_BINARY_DIR}/nod-uwp.lib"
    COMMAND_ERROR_IS_FATAL ANY)
set_property(TARGET foxhollow_uwp_nod PROPERTY IMPORTED_IMPLIB "${CMAKE_BINARY_DIR}/nod-uwp.lib")
add_library(nod::nod ALIAS foxhollow_uwp_nod)
foxhollow_uwp_import(foxhollow_uwp_zlib z)
add_library(ZLIB::ZLIB ALIAS foxhollow_uwp_zlib)
foxhollow_uwp_import(foxhollow_uwp_png libpng16)
add_library(PNG::PNG ALIAS foxhollow_uwp_png)
set_property(TARGET foxhollow_uwp_png PROPERTY INTERFACE_LINK_LIBRARIES ZLIB::ZLIB)
set(AURORA_WINDOWS_STORE ON)
set(AURORA_DAWN_IS_SHARED TRUE)
set(AURORA_SDL3_TARGET SDL3::SDL3)
set(AURORA_SDL3_IS_SHARED TRUE)
set(DAWN_ENABLE_D3D12 ON)
foreach (backend IN ITEMS D3D11 VULKAN METAL DESKTOP_GL OPENGLES NULL)
    set(DAWN_ENABLE_${backend} OFF)
endforeach ()
