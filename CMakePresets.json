{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "windows-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "FOXHOLLOW_DEBUG_SHORTCUTS": "ON"
      }
    },
    {
      "name": "uwp-x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-uwp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_SYSTEM_NAME": "WindowsStore",
        "CMAKE_SYSTEM_VERSION": "10.0",
        "CMAKE_SYSTEM_PROCESSOR": "AMD64",
        "FOXHOLLOW_ENABLE_CODE_MODS": "OFF",
        "FOXHOLLOW_DEBUG_SHORTCUTS": "OFF",
        "BUILD_SHARED_LIBS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {"name": "windows-debug", "configurePreset": "windows-debug", "targets": ["foxhollow"]},
    {"name": "uwp-x64", "configurePreset": "uwp-x64", "configuration": "Release", "targets": ["foxhollow"]},
    {"name": "uwp-x64-stage", "configurePreset": "uwp-x64", "configuration": "Release", "targets": ["foxhollow-uwp-stage"]},
    {"name": "uwp-x64-package", "configurePreset": "uwp-x64", "configuration": "Release", "targets": ["foxhollow-uwp-package"]}
  ]
}
